// GIVEN -- generic Nextflow execution config, not pipeline-specific logic.
// Real, standard Nextflow settings: real reproducibility would normally come
// from Nextflow auto-building a per-process conda env (`process.conda =
// "environment.yml"`, `conda.enabled = true`). REAL, LIVE-DISCOVERED
// CORRECTION: that doesn't work for THIS pipeline, because the actual
// bioinformatics CLI tools (prefetch, fastq-dump, fastqc, fastp, salmon,
// wget, multiqc) were deliberately split into a SEPARATE environment
// (rnaseq-tools / environment-tools.yml), not environment.yml -- see that
// file's own comment and WORKFLOW.md's environment-splitting reasoning.
// Nextflow auto-building a conda env from environment.yml per task would
// give every task a shell with pandas/nextflow but NONE of the actual
// tools -- every real command would fail with "command not found". The
// real fix here: rely on the same manually-stacked shell PATH the
// Snakemake twin was run from (`conda activate rnaseq-pipeline-workflow`
// then `conda activate --stack rnaseq-tools`) rather than per-task conda
// auto-management -- so this pipeline must be launched from that stacked
// shell, not a fresh one.

process {
    cpus = 4
    memory = '4 GB'
}

// REAL, LIVE-DISCOVERED CORRECTION: these were hardcoded to "results/...",
// so overriding params.outdir on the command line (e.g. `--outdir
// results_nf`, done to keep this pipeline's real outputs separate from the
// Snakemake twin's, for side-by-side comparison) didn't move them, AND
// Nextflow refuses to silently overwrite an existing report/timeline file
// on a rerun. Real fix: reference params.outdir (so they move with it) and
// allow overwrite (so `-resume` reruns don't need manual cleanup first).
timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/report.html"
}
